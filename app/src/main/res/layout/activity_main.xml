<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/app_name"
                android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text"/>
            <Button android:id="@+id/btnSettings" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Settings"
                style="?android:attr/borderlessButtonStyle" android:textColor="@color/muted"/>
        </LinearLayout>

        <!-- connect card -->
        <LinearLayout android:id="@+id/cardConnect" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/bg_card" android:padding="16dp"
            android:layout_marginTop="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Spotify Client ID" android:textSize="12sp"
                android:textColor="@color/muted" android:letterSpacing="0.07"/>
            <EditText android:id="@+id/inClientId" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="paste from the dashboard"
                android:textColor="@color/text" android:textColorHint="@color/muted"
                android:inputType="textNoSuggestions" android:textSize="15sp"
                android:autofillHints="" android:layout_marginTop="6dp"/>
            <TextView android:id="@+id/txtRedirect" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="12.5sp"
                android:textColor="@color/muted" android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.3"/>
            <Button android:id="@+id/btnConnect" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Connect Spotify"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <!-- listening card -->
        <LinearLayout android:id="@+id/cardListen" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/bg_card" android:padding="20dp"
            android:gravity="center" android:visibility="gone"
            android:layout_marginTop="14dp">
            <ImageView android:id="@+id/imgMic" android:layout_width="72dp"
                android:layout_height="72dp" android:src="@drawable/ic_mic"
                android:contentDescription="@string/app_name"/>
            <TextView android:id="@+id/txtHeard" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:textSize="16sp" android:textColor="@color/text"
                android:layout_marginTop="12dp" android:text="Not listening"/>
            <TextView android:id="@+id/txtStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:textSize="13.5sp" android:textColor="@color/muted"
                android:layout_marginTop="6dp"/>
            <Button android:id="@+id/btnListen" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Start listening"
                android:layout_marginTop="16dp"/>
            <Button android:id="@+id/btnTalk" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Tap to talk once"
                android:background="@drawable/bg_button" android:textColor="@color/text"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- now playing -->
        <LinearLayout android:id="@+id/cardNow" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/bg_card" android:padding="16dp"
            android:visibility="gone" android:layout_marginTop="14dp">
            <TextView android:id="@+id/txtNowTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="15sp"
                android:textStyle="bold" android:textColor="@color/text"
                android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/txtNowSub" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="13sp"
                android:textColor="@color/muted" android:maxLines="1" android:ellipsize="end"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="12dp">
                <Button android:id="@+id/btnPrev" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="Prev"
                    android:background="@drawable/bg_button" android:textColor="@color/text"/>
                <Button android:id="@+id/btnToggle" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="Play"
                    android:background="@drawable/bg_button" android:textColor="@color/text"
                    android:layout_marginStart="8dp"/>
                <Button android:id="@+id/btnNext" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="Next"
                    android:background="@drawable/bg_button" android:textColor="@color/text"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/txtLog" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="@color/muted" android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.35"/>
    </LinearLayout>
</ScrollView>
