<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VoiceDJ" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FF04120A</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/bg</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/bg</item>
    </style>

    <!-- For AuthRedirectActivity: it flashes into existence, forwards the
         OAuth code and finishes. Not an AppCompat theme, which is fine
         because that activity is a plain Activity. -->
    <style name="Theme.VoiceDJ.Transparent" parent="android:Theme.Translucent.NoTitleBar" />
</resources>
